---
import Layout from '~/layouts/PageLayout.astro';
import { withBase } from '~/utils/paths';

const metadata = {
  title: 'Página no encontrada | DavidMotoRider',
  description: 'La página que buscas no existe.',
};
---

<Layout metadata={metadata}>
  <section class="relative flex min-h-screen items-center overflow-hidden bg-black px-6 py-32 text-white">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(220,38,38,0.18),transparent_35%)]"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-black via-black/90 to-black"></div>

    <div class="relative z-10 mx-auto max-w-4xl text-center">
      <p class="font-display text-xl uppercase tracking-[0.45em] text-red-600">Error 404</p>

      <h1 class="mt-6 font-display text-7xl uppercase leading-none md:text-9xl">Página no encontrada</h1>

      <p class="mx-auto mt-8 max-w-2xl text-lg leading-8 text-zinc-400">
        Parece que este camino no lleva a ninguna parte
      </p>

      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a
          href={withBase()}
          class="rounded bg-red-600 px-8 py-4 font-display text-lg uppercase tracking-wide text-white transition hover:bg-red-700"
        >
          Volver al inicio
        </a>
      </div>
    </div>
  </section>
</Layout>
