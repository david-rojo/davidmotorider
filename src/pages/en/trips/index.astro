---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Trips | DavidMotoRider',
  description: 'All my motorcycle trips, routes, photos and experiences.',
};
---

<Layout metadata={metadata}>
  <section class="bg-black px-6 pt-32 pb-24 text-white">
    <div class="mx-auto max-w-7xl">
      <p class="font-display text-lg uppercase tracking-[0.35em] text-red-600">Adventure archive</p>

      <h1 class="mt-4 font-display text-6xl uppercase leading-none md:text-8xl">Trips</h1>

      <p class="mt-6 max-w-2xl text-zinc-400">
        Here I’ll publish my motorcycle trips, including photos, routes, lessons learned and useful details.
      </p>
    </div>
  </section>
</Layout>
