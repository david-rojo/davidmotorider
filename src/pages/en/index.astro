---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'DavidMotoRider | Experiences on two wheels',
  description: 'Motorcycle trips, GPX routes and adventures from Madrid to the world.',
};

const heroImage = `${import.meta.env.BASE_URL}/images/hero-davidmotorider.jpg`;
---

<Layout metadata={metadata}>
  <section class="relative min-h-screen overflow-hidden bg-black text-white">
    <img src={heroImage} alt="" class="absolute inset-0 h-full w-full object-cover" />

    <div class="absolute inset-0 z-10 bg-gradient-to-r from-black via-black/75 to-black/20"></div>
    <div class="absolute inset-0 z-10 bg-black/20"></div>

    <div class="relative z-20 mx-auto flex min-h-screen max-w-7xl items-center px-6 py-24">
      <div class="max-w-3xl">
        <p class="mb-6 font-display text-lg uppercase tracking-[0.35em] text-red-600 md:text-xl">
          Experiences on two wheels
        </p>

        <h1 class="font-display text-6xl uppercase leading-[1.05] tracking-wide md:text-8xl">
          Riding the world<br />
          by motorcycle<br />
          from <span class="text-red-600">Madrid</span>
        </h1>

        <p class="mt-6 max-w-xl text-lg text-gray-300">
          Real routes, authentic experiences, and useful tips for those seeking new landscapes and unforgettable
          stories.
        </p>

        <div class="mt-10 flex flex-wrap gap-4">
          <a
            href={`${import.meta.env.BASE_URL}viajes`}
            class="rounded bg-red-600 px-8 py-4 text-sm font-bold uppercase text-white transition hover:bg-red-700"
          >
            Trips
          </a>

          <a
            href={`${import.meta.env.BASE_URL}rutas-gpx`}
            class="rounded border border-white/40 px-8 py-4 text-sm font-bold uppercase text-white transition hover:bg-white hover:text-black"
          >
            GPX tracks
          </a>

          <a
            href={`${import.meta.env.BASE_URL}sobre-mi`}
            class="rounded border border-white/40 px-8 py-4 text-sm font-bold uppercase text-white transition hover:bg-white hover:text-black"
          >
            About me
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
