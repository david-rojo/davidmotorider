---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'DavidMotoRider | Experiences on two wheels',
  description: 'Motorcycle trips, GPX routes and adventures from Madrid to the world.',
};

const heroImage = `${import.meta.env.BASE_URL}/images/hero-davidmotorider.jpg`;
---

<Layout metadata={metadata}>
  <section class="relative min-h-screen overflow-hidden bg-black text-white">
    <img src={heroImage} alt="" class="absolute inset-0 h-full w-full object-cover" />

    <div class="absolute inset-0 z-10 bg-gradient-to-r from-black via-black/75 to-black/20"></div>
    <div class="absolute inset-0 z-10 bg-black/20"></div>

    <div class="relative z-20 mx-auto flex min-h-screen max-w-7xl items-center px-6 py-24">
      <div class="max-w-3xl">
        <p class="mb-6 font-display text-lg uppercase tracking-[0.35em] text-red-600 md:text-xl">
          Experiences on two wheels
        </p>

        <h1 class="font-display text-6xl uppercase leading-[1.05] tracking-wide md:text-8xl">
          Riding the world<br />
          by motorcycle<br />
          from <span class="text-red-600">Madrid</span>
        </h1>

        <p class="mt-6 max-w-xl text-lg text-gray-300">
          Real routes, authentic experiences, and useful tips for those seeking new landscapes and unforgettable
          stories.
        </p>

        <div class="mt-10 flex flex-wrap gap-4">
          <a
            href={`${import.meta.env.BASE_URL}/viajes`}
            class="rounded bg-red-600 px-8 py-4 text-sm font-bold uppercase text-white transition hover:bg-red-700"
          >
            Trips
          </a>

          <a
            href={`${import.meta.env.BASE_URL}/rutas-gpx`}
            class="rounded border border-white/40 px-8 py-4 text-sm font-bold uppercase text-white transition hover:bg-white hover:text-black"
          >
            GPX tracks
          </a>

          <a
            href={`${import.meta.env.BASE_URL}/sobre-mi`}
            class="rounded border border-white/40 px-8 py-4 text-sm font-bold uppercase text-white transition hover:bg-white hover:text-black"
          >
            About me
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-black px-6 py-24 text-white">
    <div class="mx-auto max-w-7xl">
      <div class="mb-12 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="font-display text-lg uppercase tracking-[0.35em] text-red-600">Stories on two wheels</p>
          <h2 class="mt-3 font-display text-5xl uppercase leading-none md:text-6xl">Latest trips</h2>
        </div>

        <a
          href={`${import.meta.env.BASE_URL}/es/viajes`}
          class="font-display text-xl uppercase tracking-wide text-white transition hover:text-red-600"
        >
          View all →
        </a>
      </div>

      <div class="grid gap-8 md:grid-cols-3">
        <article class="group overflow-hidden rounded-2xl bg-zinc-900">
          <a href={`${import.meta.env.BASE_URL}/en/trips/morocco`}>
            <div class="relative h-80 overflow-hidden">
              <img
                src={`${import.meta.env.BASE_URL}/images/trips/marruecos.jpg`}
                alt="Viaje en moto por Marruecos"
                class="h-full w-full object-cover transition duration-500 group-hover:scale-110"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black via-black/20 to-transparent"></div>
              <span
                class="absolute left-5 top-5 rounded-full bg-red-600 px-4 py-1 font-display text-sm uppercase tracking-wide"
              >
                Morocco
              </span>
            </div>

            <div class="p-6">
              <p class="font-display text-sm uppercase tracking-[0.25em] text-zinc-400">Adventure · Offroad · Desert</p>
              <h3 class="mt-3 font-display text-3xl uppercase leading-none text-white">Morocco on BMW F850GS</h3>
              <p class="mt-4 text-sm leading-6 text-zinc-400">
                From Madrid to the dessert: easy roads, mountain passes, gorges and nights by the dunes.
              </p>
            </div>
          </a>
        </article>

        <article class="group overflow-hidden rounded-2xl bg-zinc-900">
          <a href={`${import.meta.env.BASE_URL}/en/trips/trans-pyrenees`}>
            <div class="relative h-80 overflow-hidden">
              <img
                src={`${import.meta.env.BASE_URL}/images/trips/transpirenaica.jpg`}
                alt="Ruta Transpirenaica en moto"
                class="h-full w-full object-cover transition duration-500 group-hover:scale-110"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black via-black/20 to-transparent"></div>
              <span
                class="absolute left-5 top-5 rounded-full bg-red-600 px-4 py-1 font-display text-sm uppercase tracking-wide"
              >
                Pyrenees
              </span>
            </div>

            <div class="p-6">
              <p class="font-display text-sm uppercase tracking-[0.25em] text-zinc-400">
                Curves · Mountain · Landscapes
              </p>
              <h3 class="mt-3 font-display text-3xl uppercase leading-none text-white">Trans-Pyrenees</h3>
              <p class="mt-4 text-sm leading-6 text-zinc-400">
                From the Cantabrian Sea to the Mediterranean, crossing mountain passes, valleys and some of the best
                landscapes in the north.
              </p>
            </div>
          </a>
        </article>

        <article class="group overflow-hidden rounded-2xl bg-zinc-900">
          <a href={`${import.meta.env.BASE_URL}/en/trips/picos-de-europa`}>
            <div class="relative h-80 overflow-hidden">
              <img
                src={`${import.meta.env.BASE_URL}/images/trips/picos-europa.jpg`}
                alt="Ruta en moto por Picos de Europa"
                class="h-full w-full object-cover transition duration-500 group-hover:scale-110"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black via-black/20 to-transparent"></div>
              <span
                class="absolute left-5 top-5 rounded-full bg-red-600 px-4 py-1 font-display text-sm uppercase tracking-wide"
              >
                Picos de Europa
              </span>
            </div>

            <div class="p-6">
              <p class="font-display text-sm uppercase tracking-[0.25em] text-zinc-400">Asphalt · Mountain · North</p>
              <h3 class="mt-3 font-display text-3xl uppercase leading-none text-white">Picos de Europa</h3>
              <p class="mt-4 text-sm leading-6 text-zinc-400">
                Spectacular roads, viewpoints, gorges and villages perfect for a motorcycle getaway.
              </p>
            </div>
          </a>
        </article>
      </div>
    </div>
  </section>
</Layout>
