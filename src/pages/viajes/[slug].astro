---
import { getCollection, render } from 'astro:content';
import Layout from '~/layouts/PageLayout.astro';

export async function getStaticPaths() {
  const trips = await getCollection('trips');

  return trips.map((trip) => ({
    params: { slug: trip.data.slug },
    props: { trip },
  }));
}

const { trip } = Astro.props;
const { Content } = await render(trip);

const metadata = {
  title: `${trip.data.title} | DavidMotoRider`,
  description: trip.data.description,
};
---

<Layout metadata={metadata}>
  <section class="relative min-h-[85vh] overflow-hidden bg-black text-white">
    <img
      src={`${import.meta.env.BASE_URL}${trip.data.image}`}
      alt={trip.data.title}
      class="absolute inset-0 h-full w-full object-cover"
    />

    <div class="absolute inset-0 bg-gradient-to-t from-black via-black/70 to-black/30"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/40 to-transparent"></div>

    <div class="relative z-10 mx-auto flex min-h-[85vh] max-w-7xl items-end px-6 pb-20 pt-40">
      <div class="max-w-4xl">
        <p class="font-display text-lg uppercase tracking-[0.35em] text-red-600">
          {trip.data.category}
        </p>

        <h1 class="mt-5 max-w-5xl font-display text-6xl uppercase leading-[0.9] md:text-8xl">
          {trip.data.title}
        </h1>

        <p class="mt-8 max-w-3xl text-xl leading-9 text-zinc-300">
          {trip.data.description}
        </p>

        <div class="mt-10 flex flex-wrap gap-4">
          <div
            class="rounded-full border border-white/15 bg-black/40 px-5 py-2 font-display text-lg uppercase tracking-wide backdrop-blur-sm"
          >
            {trip.data.days}
            {trip.data.days === 1 ? 'día' : 'días'}
          </div>

          <div
            class="rounded-full border border-white/15 bg-black/40 px-5 py-2 font-display text-lg uppercase tracking-wide backdrop-blur-sm"
          >
            {trip.data.km.toLocaleString('es-ES')} km
          </div>
        </div>
      </div>
    </div>
  </section>

  {
    trip.data.itinerary?.length ? (
      <section class="bg-black px-6 py-24 text-white">
        <div class="mx-auto max-w-7xl">
          <div class="mb-14 max-w-3xl">
            <p class="font-display text-lg uppercase tracking-[0.35em] text-red-600">Ruta día a día</p>

            <h2 class="mt-4 font-display text-5xl uppercase leading-none md:text-7xl">Itinerario</h2>

            <p class="mt-6 text-lg leading-8 text-zinc-400">
              Desglose orientativo de las etapas, kilómetros y puntos principales de cada jornada.
            </p>
          </div>

          <div class="space-y-10">
            {trip.data.itinerary.map((day) => (
              <article class="grid overflow-hidden rounded-3xl border border-white/10 bg-zinc-950 md:grid-cols-[0.9fr_1.1fr]">
                {day.image ? (
                  <div class="relative min-h-[280px]">
                    <img
                      src={`${import.meta.env.BASE_URL}${day.image}`}
                      alt={day.title}
                      loading="lazy"
                      decoding="async"
                      class="absolute inset-0 h-full w-full object-cover"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent md:bg-gradient-to-r md:from-black/50 md:to-transparent" />
                  </div>
                ) : (
                  <div class="flex min-h-[280px] items-center justify-center bg-white/[0.03]">
                    <p class="font-display text-6xl text-white/10">DÍA {day.day}</p>
                  </div>
                )}

                <div class="flex flex-col justify-center p-8 md:p-10">
                  <div class="flex flex-wrap items-center gap-3">
                    <span class="rounded-full bg-red-600 px-5 py-2 font-display text-sm uppercase tracking-wide text-white">
                      Día {day.day}
                    </span>

                    <span class="rounded-full border border-white/10 bg-white/5 px-5 py-2 font-display text-sm uppercase tracking-wide text-zinc-300">
                      {day.km.toLocaleString('es-ES')} km
                    </span>
                  </div>

                  <h3 class="mt-6 font-display text-4xl uppercase leading-none text-white md:text-5xl">{day.title}</h3>

                  <p class="mt-5 text-base leading-8 text-zinc-400">{day.description}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    ) : null
  }

  <section class="bg-black px-6 py-24 text-white">
    <div class="mx-auto grid max-w-7xl gap-14 lg:grid-cols-[260px_1fr]">
      <aside class="hidden lg:block">
        <div class="sticky top-28 rounded-2xl border border-white/10 bg-white/[0.03] p-6">
          <p class="font-display text-xl uppercase text-red-600">Datos del viaje</p>

          <div class="mt-6 space-y-4 text-sm text-zinc-400">
            <div>
              <p class="font-display text-3xl text-white">{trip.data.days}</p>
              <p class="uppercase tracking-wide">{trip.data.days === 1 ? 'día' : 'días'}</p>
            </div>

            <div>
              <p class="font-display text-3xl text-white">
                {trip.data.km.toLocaleString('es-ES')}
              </p>
              <p class="uppercase tracking-wide">kilómetros</p>
            </div>

            <div>
              <p class="font-display text-3xl text-white">{trip.data.category}</p>
              <p class="uppercase tracking-wide">destino</p>
            </div>
          </div>
        </div>
      </aside>

      <article
        class="prose prose-invert max-w-none prose-headings:font-display prose-headings:uppercase prose-h2:text-5xl prose-p:text-zinc-400 prose-p:leading-8 prose-li:text-zinc-400 prose-strong:text-white"
      >
        <Content />
        {
          trip.data.gallery?.length ? (
            <>
              <div class="not-prose mt-20">
                <h2 class="font-display text-4xl uppercase leading-none text-white md:text-5xl">Galería</h2>

                <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
                  {trip.data.gallery.map((image) => (
                    <button
                      type="button"
                      class="group block overflow-hidden rounded-2xl bg-transparent p-0"
                      data-gallery-image
                      data-src={`${import.meta.env.BASE_URL}${image.src}`}
                      data-alt={image.alt}
                    >
                      <img
                        src={`${import.meta.env.BASE_URL}${image.src}`}
                        alt={image.alt}
                        loading="lazy"
                        decoding="async"
                        class="aspect-[4/3] w-full rounded-2xl object-cover transition duration-500 group-hover:scale-105"
                      />
                    </button>
                  ))}
                </div>
              </div>

              <dialog
                id="gallery-dialog"
                class="m-auto w-[95vw] max-w-6xl rounded-2xl bg-black p-0 backdrop:bg-black/80"
              >
                <button
                  id="gallery-prev"
                  type="button"
                  class="absolute left-3 top-1/2 z-10 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-black/50 font-display text-3xl leading-none text-white backdrop-blur-sm transition hover:bg-red-600 md:left-6 md:h-16 md:w-16 md:text-6xl"
                >
                  ‹
                </button>

                <button
                  id="gallery-next"
                  type="button"
                  class="absolute right-3 top-1/2 z-10 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-black/50 font-display text-3xl leading-none text-white backdrop-blur-sm transition hover:bg-red-600 md:right-6 md:h-16 md:w-16 md:text-6xl"
                >
                  ›
                </button>
                <button
                  id="gallery-close"
                  type="button"
                  class="absolute right-3 top-3 z-20 flex h-10 w-10 items-center justify-center rounded-full bg-black/50 font-display text-2xl text-white backdrop-blur-sm transition hover:bg-red-600 md:right-6 md:top-6 md:h-14 md:w-14 md:text-4xl"
                  aria-label="Cerrar galería"
                >
                  ✕
                </button>
                <p id="gallery-dialog-caption" class="px-6 pb-6 pt-4 text-center text-sm leading-7 text-zinc-300" />
                <img id="gallery-dialog-image" src="" alt="" class="max-h-[85vh] w-full object-contain" />
              </dialog>
            </>
          ) : null
        }
      </article>
    </div>
  </section>

  <script is:inline>
    const dialog = document.getElementById('gallery-dialog');
    const dialogImage = document.getElementById('gallery-dialog-image');
    const dialogCaption = document.getElementById('gallery-dialog-caption');
    const closeButton = document.getElementById('gallery-close');
    const prevButton = document.getElementById('gallery-prev');
    const nextButton = document.getElementById('gallery-next');

    const galleryButtons = Array.from(document.querySelectorAll('[data-gallery-image]'));
    let currentIndex = 0;

    const showImage = (index) => {
      const button = galleryButtons[index];
      if (!button || !(dialogImage instanceof HTMLImageElement)) return;

      currentIndex = index;

      dialogImage.src = button.dataset.src ?? '';
      dialogImage.alt = button.dataset.alt ?? '';

      if (dialogCaption) {
        dialogCaption.textContent = button.dataset.alt ?? '';
      }
    };

    galleryButtons.forEach((button, index) => {
      button.addEventListener('click', () => {
        if (!(dialog instanceof HTMLDialogElement)) return;

        showImage(index);
        dialog.showModal();
      });
    });

    prevButton?.addEventListener('click', () => {
      const prevIndex = (currentIndex - 1 + galleryButtons.length) % galleryButtons.length;
      showImage(prevIndex);
    });

    nextButton?.addEventListener('click', () => {
      const nextIndex = (currentIndex + 1) % galleryButtons.length;
      showImage(nextIndex);
    });

    closeButton?.addEventListener('click', () => {
      if (dialog instanceof HTMLDialogElement) dialog.close();
    });

    dialog?.addEventListener('click', (event) => {
      if (event.target === dialog && dialog instanceof HTMLDialogElement) {
        dialog.close();
      }
    });

    document.addEventListener('keydown', (event) => {
      if (!(dialog instanceof HTMLDialogElement) || !dialog.open) return;

      if (event.key === 'ArrowLeft') {
        const prevIndex = (currentIndex - 1 + galleryButtons.length) % galleryButtons.length;
        showImage(prevIndex);
      }

      if (event.key === 'ArrowRight') {
        const nextIndex = (currentIndex + 1) % galleryButtons.length;
        showImage(nextIndex);
      }

      if (event.key === 'Escape') {
        dialog.close();
      }
    });
  </script></Layout
>
