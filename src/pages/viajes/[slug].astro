---
import { getCollection, render } from 'astro:content';
import Layout from '~/layouts/PageLayout.astro';

export async function getStaticPaths() {
  const publishedTrips = (await getCollection('trips')).filter((trip) => trip.data.status === 'published');

  return publishedTrips.map((trip) => ({
    params: { slug: trip.data.slug },
    props: { trip },
  }));
}

const { trip } = Astro.props;
const { Content } = await render(trip);

const metadata = {
  title: `${trip.data.title} | DavidMotoRider`,
  description: trip.data.description,
};

const travelDate = trip.data.date
  .toLocaleDateString('es-ES', {
    month: 'short',
    year: 'numeric',
  })
  .toUpperCase();

const getInternalUrl = (href: string) => {
  const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
  const cleanHref = href.replace(/^\//, '');

  return `${baseUrl}/${cleanHref}`;
};

const renderTip = (tip: string) =>
  tip
    .replace(/\[([^\]]+)\]\((https?:\/\/[^)\s]+)\)/g, '<a href="$2" target="_blank" rel="noopener noreferrer">$1</a>')
    .replace(/\[([^\]]+)\]\((\/[^)\s]+)\)/g, (_match, text, href) => {
      return `<a href="${getInternalUrl(href)}">${text}</a>`;
    });

const getItineraryDescription = (description: string | string[] | undefined) =>
  description ? JSON.stringify(Array.isArray(description) ? description : [description]) : undefined;
---

<Layout metadata={metadata}>
  <section class="relative overflow-hidden bg-black text-white">
    <img
      src={`${import.meta.env.BASE_URL}${trip.data.image}`}
      alt={trip.data.title}
      class="absolute inset-0 h-full w-full object-cover"
    />

    <div class="absolute inset-0 bg-gradient-to-t from-black via-black/70 to-black/30"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/40 to-transparent"></div>

    <div class="relative z-10 mx-auto flex max-w-7xl items-end px-6 pb-12 pt-28">
      <div class="max-w-4xl">
        <p class="font-display text-lg uppercase tracking-[0.35em] text-red-600">
          {trip.data.category}
        </p>

        <h1 class="mt-5 max-w-5xl font-display text-6xl uppercase leading-[0.9] md:text-8xl">
          {trip.data.title}
        </h1>

        <p class="mt-8 max-w-3xl text-justify text-xl leading-9 text-zinc-300">
          {trip.data.description}
        </p>

        <div class="mt-10 flex flex-wrap items-center gap-4">
          <div
            class="rounded-full border border-white/15 bg-black/40 px-5 py-2 font-display text-lg uppercase tracking-wide backdrop-blur-sm"
          >
            {trip.data.days}
            {trip.data.days === 1 ? 'día' : 'días'}
          </div>

          <div
            class="rounded-full border border-white/15 bg-black/40 px-5 py-2 font-display text-lg uppercase tracking-wide backdrop-blur-sm"
          >
            {trip.data.km.toLocaleString('es-ES')} km
          </div>

          <span
            class="rounded-full border border-white/10 bg-black/40 px-5 py-2 font-display text-lg uppercase tracking-wide text-white backdrop-blur-sm"
          >
            {travelDate}
          </span>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-black pb-24 pt-8 text-white">
    <div class="mx-auto max-w-7xl px-6">
      <article
        class="prose prose-invert max-w-none prose-headings:font-display prose-headings:uppercase prose-h2:text-5xl prose-p:text-justify prose-p:text-zinc-400 prose-p:leading-8 prose-li:text-zinc-400 prose-strong:text-white"
      >
        <Content />

        {
          trip.data.map && (
            <div class="not-prose mt-14">
              <h2 class="font-display text-4xl uppercase leading-none text-white md:text-5xl">Mapa de la ruta</h2>

              <img
                src={`${import.meta.env.BASE_URL}${trip.data.map}`}
                alt={`Mapa general de ${trip.data.title}`}
                loading="lazy"
                decoding="async"
                class="mt-8 rounded-3xl border border-white/10"
              />
            </div>
          )
        }

        {
          trip.data.itinerary?.length ? (
            <div class="not-prose mt-20">
              <div class="mb-12">
                <h2 class="mt-4 font-display text-4xl uppercase leading-none text-white md:text-5xl">Itinerario</h2>
              </div>

              <div class="grid gap-6 md:grid-cols-2">
                {trip.data.itinerary.map((day) => (
                  <article
                    class:list={[
                      'group overflow-hidden rounded-3xl border border-white/10 bg-zinc-950 transition duration-300',
                      day.description &&
                        'cursor-pointer hover:-translate-y-1 hover:border-red-600/70 hover:bg-zinc-900',
                    ]}
                    role={day.description ? 'button' : undefined}
                    tabindex={day.description ? '0' : undefined}
                    data-itinerary-item={day.description ? '' : undefined}
                    data-itinerary-day={day.description ? day.day : undefined}
                    data-itinerary-title={day.description ? day.title : undefined}
                    data-itinerary-description={getItineraryDescription(day.description)}
                  >
                    {day.image && (
                      <div class="relative h-52 overflow-hidden">
                        <img
                          src={`${import.meta.env.BASE_URL}${day.image}`}
                          alt={day.title}
                          loading="lazy"
                          decoding="async"
                          class="h-full w-full object-cover transition duration-700 group-hover:scale-105"
                        />
                        <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent" />
                      </div>
                    )}

                    <div class="p-6">
                      <div class="flex flex-wrap items-center gap-3">
                        <span class="rounded-full bg-red-600 px-4 py-2 font-display text-sm uppercase tracking-wide text-white">
                          Día {day.day}
                        </span>

                        <span class="rounded-full border border-white/10 bg-white/5 px-4 py-2 font-display text-sm uppercase tracking-wide text-zinc-300">
                          {day.km.toLocaleString('es-ES')} km
                        </span>
                      </div>

                      <h3 class="mt-5 font-display text-3xl uppercase leading-none text-white">{day.title}</h3>

                      <div class="mt-6 flex flex-wrap items-center gap-3">
                        <div class="flex flex-wrap gap-3">
                          {day.wikiloc && (
                            <a
                              href={day.wikiloc}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="rounded-full border border-white/10 px-4 py-2 font-display text-sm uppercase tracking-wide text-zinc-300 transition hover:border-red-600 hover:text-white"
                            >
                              Wikiloc
                            </a>
                          )}

                          {day.googleMaps && (
                            <a
                              href={day.googleMaps}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="rounded-full border border-white/10 px-4 py-2 font-display text-sm uppercase tracking-wide text-zinc-300 transition hover:border-red-600 hover:text-white"
                            >
                              Google Maps
                            </a>
                          )}
                        </div>

                        {day.description && (
                          <span class="ml-auto inline-flex items-center gap-2 font-display text-sm uppercase tracking-wide text-red-500 transition duration-300 md:opacity-0 md:group-hover:translate-x-1 md:group-hover:opacity-100">
                            Ver día
                            <span aria-hidden="true">→</span>
                          </span>
                        )}
                      </div>
                    </div>
                  </article>
                ))}
              </div>
            </div>
          ) : null
        }

        {
          trip.data.tips?.length ? (
            <div class="not-prose mt-20">
              <h2 class="font-display text-4xl uppercase leading-none text-white md:text-5xl">Consejos útiles</h2>

              <ul class="mt-8 space-y-4">
                {trip.data.tips.map((tip) => (
                  <li class="flex items-start gap-4 text-zinc-400">
                    <span class="mt-3 h-2 w-2 shrink-0 rounded-full bg-red-600" />
                    <span
                      class="text-justify leading-8 [&_a]:font-semibold [&_a]:text-white [&_a]:underline [&_a]:decoration-white/50 [&_a]:underline-offset-4 [&_a]:transition hover:[&_a]:text-red-500 hover:[&_a]:decoration-red-600/70"
                      set:html={renderTip(tip)}
                    />
                  </li>
                ))}
              </ul>
            </div>
          ) : null
        }

        <dialog
          id="itinerary-dialog"
          class="m-auto w-[92vw] max-w-3xl rounded-3xl border border-white/10 bg-black p-0 text-white backdrop:bg-black/80"
        >
          <div class="relative px-6 pb-8 pt-6 md:px-10 md:pb-10 md:pt-8">
            <div class="flex items-center justify-between gap-4">
              <p id="itinerary-dialog-day" class="font-display text-sm uppercase tracking-[0.3em] text-red-600"></p>

              <button
                id="itinerary-close"
                type="button"
                class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-black/50 font-display text-2xl text-white backdrop-blur-sm transition hover:bg-red-600 md:h-14 md:w-14 md:text-4xl"
                aria-label="Cerrar detalle del día"
              >
                ✕
              </button>
            </div>

            <h3
              id="itinerary-dialog-title"
              class="mt-6 text-center font-display text-4xl uppercase leading-none text-white md:text-5xl"
            >
            </h3>

            <div
              id="itinerary-dialog-description"
              class="mt-8 space-y-5 text-justify text-lg leading-8 text-zinc-300 [&_a]:font-semibold [&_a]:text-white [&_a]:underline [&_a]:decoration-white/50 [&_a]:underline-offset-4 [&_a]:transition hover:[&_a]:text-red-500 hover:[&_a]:decoration-red-600/70 [&_em]:italic [&_em]:text-zinc-200 [&_strong]:font-semibold [&_strong]:text-white"
            >
            </div>
          </div>
        </dialog>

        {
          trip.data.gallery?.length ? (
            <>
              <div class="not-prose mt-20">
                <h2 class="font-display text-4xl uppercase leading-none text-white md:text-5xl">Galería</h2>

                <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
                  {trip.data.gallery.map((image) => (
                    <button
                      type="button"
                      class="group block overflow-hidden rounded-2xl bg-transparent p-0"
                      data-gallery-image
                      data-src={`${import.meta.env.BASE_URL}${image.src}`}
                      data-alt={image.alt}
                    >
                      <img
                        src={`${import.meta.env.BASE_URL}${image.src}`}
                        alt={image.alt}
                        loading="lazy"
                        decoding="async"
                        class="aspect-[4/3] w-full rounded-2xl object-cover transition duration-500 group-hover:scale-105"
                      />
                    </button>
                  ))}
                </div>
              </div>

              <dialog
                id="gallery-dialog"
                class="m-auto w-[95vw] max-w-6xl rounded-2xl bg-black p-0 backdrop:bg-black/80"
              >
                <button
                  id="gallery-prev"
                  type="button"
                  class="absolute left-3 top-1/2 z-10 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-black/50 font-display text-3xl leading-none text-white backdrop-blur-sm transition hover:bg-red-600 md:left-6 md:h-16 md:w-16 md:text-6xl"
                >
                  ‹
                </button>

                <button
                  id="gallery-next"
                  type="button"
                  class="absolute right-3 top-1/2 z-10 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-black/50 font-display text-3xl leading-none text-white backdrop-blur-sm transition hover:bg-red-600 md:right-6 md:h-16 md:w-16 md:text-6xl"
                >
                  ›
                </button>
                <button
                  id="gallery-close"
                  type="button"
                  class="absolute right-3 top-3 z-20 flex h-10 w-10 items-center justify-center rounded-full bg-black/50 font-display text-2xl text-white backdrop-blur-sm transition hover:bg-red-600 md:right-6 md:top-6 md:h-14 md:w-14 md:text-4xl"
                  aria-label="Cerrar galería"
                >
                  ✕
                </button>
                <p id="gallery-dialog-caption" class="px-6 pb-6 pt-4 text-center text-sm leading-7 text-zinc-300" />
                <img id="gallery-dialog-image" src="" alt="" class="max-h-[85vh] w-full object-contain" />
              </dialog>
            </>
          ) : null
        }
      </article>
    </div>
  </section>

  <script is:inline data-base-url={import.meta.env.BASE_URL.replace(/\/$/, '')}>
    const dialog = document.getElementById('gallery-dialog');
    const dialogImage = document.getElementById('gallery-dialog-image');
    const dialogCaption = document.getElementById('gallery-dialog-caption');
    const closeButton = document.getElementById('gallery-close');
    const prevButton = document.getElementById('gallery-prev');
    const nextButton = document.getElementById('gallery-next');
    const itineraryDialog = document.getElementById('itinerary-dialog');
    const itineraryDay = document.getElementById('itinerary-dialog-day');
    const itineraryTitle = document.getElementById('itinerary-dialog-title');
    const itineraryDescription = document.getElementById('itinerary-dialog-description');
    const itineraryCloseButton = document.getElementById('itinerary-close');

    const galleryButtons = Array.from(document.querySelectorAll('[data-gallery-image]'));
    const itineraryItems = Array.from(document.querySelectorAll('[data-itinerary-item]'));
    const baseUrl = document.currentScript?.dataset.baseUrl ?? '';
    let currentIndex = 0;

    const escapeHtml = (value) =>
      value
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');

    const renderItineraryMarkdown = (value) =>
      escapeHtml(value)
        .replace(
          /\[([^\]]+)\]\((https?:\/\/[^)\s]+)\)/g,
          '<a href="$2" target="_blank" rel="noopener noreferrer">$1</a>'
        )
        .replace(/\[([^\]]+)\]\((\/[^)\s]+)\)/g, (_match, text, href) => `<a href="${baseUrl}${href}">${text}</a>`)
        .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
        .replace(/(^|[\s([{])_([^_\n]+)_(?=[\s.,;:!?)}\]]|$)/g, '$1<em>$2</em>');

    const showItineraryDay = (item) => {
      if (!(itineraryDialog instanceof HTMLDialogElement)) return;

      if (itineraryDay) itineraryDay.textContent = `Día ${item.dataset.itineraryDay ?? ''}`;
      if (itineraryTitle) itineraryTitle.textContent = item.dataset.itineraryTitle ?? '';
      if (itineraryDescription) {
        itineraryDescription.textContent = '';

        const paragraphs = JSON.parse(item.dataset.itineraryDescription ?? '[]');
        paragraphs.forEach((paragraph) => {
          const element = document.createElement('p');
          element.innerHTML = renderItineraryMarkdown(paragraph);
          itineraryDescription.appendChild(element);
        });
      }

      itineraryDialog.showModal();
    };

    itineraryItems.forEach((item) => {
      item.addEventListener('click', (event) => {
        if (event.target instanceof Element && event.target.closest('a')) return;
        showItineraryDay(item);
      });

      item.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter' && event.key !== ' ') return;
        event.preventDefault();
        showItineraryDay(item);
      });
    });

    itineraryCloseButton?.addEventListener('click', () => {
      if (itineraryDialog instanceof HTMLDialogElement) itineraryDialog.close();
    });

    itineraryDialog?.addEventListener('click', (event) => {
      if (event.target === itineraryDialog && itineraryDialog instanceof HTMLDialogElement) {
        itineraryDialog.close();
      }
    });

    const showImage = (index) => {
      const button = galleryButtons[index];
      if (!button || !(dialogImage instanceof HTMLImageElement)) return;

      currentIndex = index;

      dialogImage.src = button.dataset.src ?? '';
      dialogImage.alt = button.dataset.alt ?? '';

      if (dialogCaption) {
        dialogCaption.textContent = button.dataset.alt ?? '';
      }
    };

    galleryButtons.forEach((button, index) => {
      button.addEventListener('click', () => {
        if (!(dialog instanceof HTMLDialogElement)) return;

        showImage(index);
        dialog.showModal();
      });
    });

    prevButton?.addEventListener('click', () => {
      const prevIndex = (currentIndex - 1 + galleryButtons.length) % galleryButtons.length;
      showImage(prevIndex);
    });

    nextButton?.addEventListener('click', () => {
      const nextIndex = (currentIndex + 1) % galleryButtons.length;
      showImage(nextIndex);
    });

    closeButton?.addEventListener('click', () => {
      if (dialog instanceof HTMLDialogElement) dialog.close();
    });

    dialog?.addEventListener('click', (event) => {
      if (event.target === dialog && dialog instanceof HTMLDialogElement) {
        dialog.close();
      }
    });

    document.addEventListener('keydown', (event) => {
      if (!(dialog instanceof HTMLDialogElement) || !dialog.open) return;

      if (event.key === 'ArrowLeft') {
        const prevIndex = (currentIndex - 1 + galleryButtons.length) % galleryButtons.length;
        showImage(prevIndex);
      }

      if (event.key === 'ArrowRight') {
        const nextIndex = (currentIndex + 1) % galleryButtons.length;
        showImage(nextIndex);
      }

      if (event.key === 'Escape') {
        dialog.close();
      }
    });
  </script></Layout
>
