---
import Layout from '~/layouts/PageLayout.astro';
import { getCollection } from 'astro:content';
import TripCard from '~/components/trips/TripCard.astro';
import { Icon } from 'astro-icon/components';

const metadata = {
  title: 'DavidMotoRider | Experiencias sobre dos ruedas',
  description: 'Viajes en moto, rutas GPX y aventuras desde Madrid al mundo.',
};

const heroDesktopWebp = `${import.meta.env.BASE_URL}/images/hero/home-desktop.webp`;
const heroMobileWebp = `${import.meta.env.BASE_URL}/images/hero/home-mobile.webp`;
const heroDesktopJpg = `${import.meta.env.BASE_URL}/images/hero/home-desktop.jpg`;
const heroMobileJpg = `${import.meta.env.BASE_URL}/images/hero/home-mobile.jpg`;

const lastPublishedTrips = (await getCollection('trips'))
  .filter((trip) => trip.data.type === 'viaje' && trip.data.status === 'published')
  .sort((a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime())
  .slice(0, 3);

const latestResource = (await getCollection('resources'))
  .filter((resource) => resource.data.status === 'published')
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())[0];

const aboutImage = `${import.meta.env.BASE_URL}/images/sobre-mi-card.jpg`;
---

<Layout metadata={metadata}>
  <section class="relative min-h-screen overflow-hidden bg-black text-white">
    <picture>
      <source srcset={heroMobileWebp} media="(max-width: 767px)" type="image/webp" />
      <source srcset={heroDesktopWebp} type="image/webp" />
      <source srcset={heroMobileJpg} media="(max-width: 767px)" type="image/jpeg" />
      <img
        src={heroDesktopJpg}
        alt=""
        decoding="async"
        fetchpriority="high"
        width="1920"
        height="1235"
        class="absolute inset-0 h-full w-full object-cover"
      />
    </picture>

    <div class="absolute inset-0 z-10 bg-gradient-to-r from-black via-black/75 to-black/20"></div>
    <div class="absolute inset-0 z-10 bg-black/20"></div>

    <div class="relative z-20 mx-auto flex min-h-screen max-w-7xl items-center px-6 py-24">
      <div class="max-w-3xl">
        <p class="mb-6 font-display text-lg uppercase tracking-[0.35em] text-red-600 md:text-xl">
          Experiencias sobre dos ruedas
        </p>

        <h1 class="font-display text-6xl uppercase leading-[1.05] tracking-wide md:text-8xl">
          Viajando en moto<br />
          desde <span class="text-red-600">Madrid</span><br />
          por el mundo
        </h1>

        <p class="mt-6 max-w-xl text-lg text-gray-300">
          Rutas reales, experiencias auténticas y consejos útiles para quienes buscan nuevos paisajes e historias para
          recordar
        </p>

        <div class="mt-10 flex flex-wrap gap-4">
          <a
            href={`${import.meta.env.BASE_URL}/viajes`}
            class="rounded bg-red-600 px-8 py-4 text-sm font-bold uppercase text-white transition hover:bg-red-700"
          >
            Ver viajes
          </a>

          <!-- disable escapadas
          <a
            href={`${import.meta.env.BASE_URL}/escapadas`}
            class="rounded border border-white/40 px-8 py-4 text-sm font-bold uppercase text-white transition hover:bg-white hover:text-black"
          >
            Ver escapadas
          </a>
          -->

          <a
            href={`${import.meta.env.BASE_URL}/sobre-mi`}
            class="rounded border border-white/40 px-8 py-4 text-sm font-bold uppercase text-white transition hover:bg-white hover:text-black"
          >
            Sobre mí
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-black px-6 py-24 text-white">
    <div class="mx-auto max-w-7xl">
      <div class="mb-12 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="font-display text-lg uppercase tracking-[0.35em] text-red-600">Historias sobre dos ruedas</p>
          <h2 class="mt-3 font-display text-5xl uppercase leading-none md:text-6xl">Últimos viajes</h2>
        </div>

        <a
          href={`${import.meta.env.BASE_URL}/viajes`}
          class="font-display text-xl uppercase tracking-wide text-white transition hover:text-red-600"
        >
          Ver todos →
        </a>
      </div>

      <div class="grid gap-8 md:grid-cols-3">
        {
          lastPublishedTrips.map((trip) => (
            <TripCard
              title={trip.data.title}
              description={trip.data.description}
              image={`${import.meta.env.BASE_URL}${trip.data.image}`}
              category={trip.data.category}
              tags={trip.data.tags.join(' · ')}
              href={`${import.meta.env.BASE_URL}/viajes/${trip.data.slug}`}
              days={trip.data.days}
              km={trip.data.km}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-y border-white/10 bg-white py-10 text-black">
    <div class="mx-auto grid max-w-7xl gap-8 px-6 md:grid-cols-2 lg:grid-cols-4">
      <div class="flex items-start gap-4 border-black/10 lg:border-r lg:pr-6">
        <Icon name="tabler:route" class="mt-1 h-10 w-10 shrink-0 text-black" aria-hidden="true" />

        <div>
          <h3 class="font-display text-xl uppercase">Viajes reales</h3>

          <p class="mt-1 text-sm leading-6 text-zinc-600">Mis viajes realizados con todos los detalles</p>
        </div>
      </div>

      <div class="flex items-start gap-4 border-black/10 lg:border-r lg:pr-6">
        <Icon name="tabler:map-2" class="mt-1 h-10 w-10 shrink-0 text-black" aria-hidden="true" />

        <div>
          <h3 class="font-display text-xl uppercase">Tracks</h3>

          <p class="mt-1 text-sm leading-6 text-zinc-600">Tracks GPX y rutas Google Maps de cada viaje</p>
        </div>
      </div>

      <div class="flex items-start gap-4 border-black/10 lg:border-r lg:pr-6">
        <Icon name="tabler:camera" class="mt-1 h-10 w-10 shrink-0 text-black" aria-hidden="true" />

        <div>
          <h3 class="font-display text-xl uppercase">Fotografía</h3>

          <p class="mt-1 text-sm leading-6 text-zinc-600">Imágenes capturadas durante los viajes</p>
        </div>
      </div>

      <div class="flex items-start gap-4">
        <Icon name="tabler:tools" class="mt-1 h-10 w-10 shrink-0 text-black" aria-hidden="true" />

        <div>
          <h3 class="font-display text-xl uppercase">Consejos útiles</h3>

          <p class="mt-1 text-sm leading-6 text-zinc-600">Equipamiento, rutas y preparación</p>
        </div>
      </div>
    </div>
  </section>
  <section class="bg-black px-6 py-24 text-white">
    <div class="mx-auto grid max-w-7xl gap-14 lg:grid-cols-2 lg:items-center">
      <!-- SOBRE MÍ -->
      <div class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
        <div>
          <p class="font-display text-lg uppercase tracking-[0.35em] text-red-600">Sobre mí</p>

          <h2 class="mt-4 font-display text-5xl uppercase leading-none md:text-4xl lg:text-5xl">Quién soy</h2>

          <p class="mt-6 text-justify text-base leading-8 text-zinc-400 md:text-left">
            Viajo en moto desde Madrid y disfruto preparando rutas, descubriendo carreteras y aprendiendo en cada viaje.
          </p>

          <a
            href={`${import.meta.env.BASE_URL}/sobre-mi`}
            class="mx-auto mt-8 block w-fit rounded bg-red-600 px-7 py-3 font-display text-lg uppercase tracking-wide text-white transition hover:bg-red-700 lg:mx-0 lg:inline-block"
          >
            Conóceme mejor
          </a>
        </div>

        <div class="h-full min-h-[280px] overflow-hidden rounded-3xl border border-white/10">
          <img
            src={aboutImage}
            alt="viajando en moto"
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover"
          />
        </div>
      </div>

      <!-- ÚLTIMO RECURSO -->
      {
        latestResource && (
          <div class="grid gap-8 lg:grid-cols-[1.4fr_0.8fr] lg:items-center">
            <div>
              <p class="font-display text-lg uppercase tracking-[0.35em] text-red-600">Último recurso publicado</p>

              <h2 class="mt-4 font-display text-5xl uppercase leading-none md:text-[3rem] lg:text-[3.5rem]">
                {latestResource.data.title}
              </h2>

              <p class="mt-6 text-base leading-8 text-zinc-400">{latestResource.data.description}</p>

              <a
                href={`${import.meta.env.BASE_URL}/recursos/${latestResource.data.slug}`}
                class="mt-8 inline-block font-display text-xl uppercase tracking-wide text-red-600 transition hover:text-red-500"
              >
                Leer recurso →
              </a>
            </div>

            {latestResource.data.image && (
              <div class="h-full min-h-[280px] overflow-hidden rounded-3xl border border-white/10">
                <img
                  src={`${import.meta.env.BASE_URL}${latestResource.data.image}`}
                  alt={latestResource.data.title}
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover"
                />
              </div>
            )}
          </div>
        )
      }
    </div>
  </section>
</Layout>
