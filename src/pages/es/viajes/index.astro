---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Viajes | DavidMotoRider',
  description: 'Todos mis viajes en moto, rutas, fotos y experiencias.',
};
---

<Layout metadata={metadata}>
  <section class="bg-black px-6 pt-32 pb-24 text-white">
    <div class="mx-auto max-w-7xl">
      <p class="font-display text-lg uppercase tracking-[0.35em] text-red-600">Archivo de aventuras</p>

      <h1 class="mt-4 font-display text-6xl uppercase leading-none md:text-8xl">Viajes</h1>

      <p class="mt-6 max-w-2xl text-zinc-400">
        Aquí iré publicando mis viajes en moto, con fotos, rutas, aprendizajes y detalles útiles.
      </p>
    </div>
  </section>
</Layout>
