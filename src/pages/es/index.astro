---
import Layout from '~/layouts/PageLayout.astro';
import TripCard from '~/components/trips/TripCard.astro';

const metadata = {
  title: 'DavidMotoRider | Experiencias sobre dos ruedas',
  description: 'Viajes en moto, rutas GPX y aventuras desde Madrid al mundo.',
};

const heroImage = `${import.meta.env.BASE_URL}/images/hero-davidmotorider.jpg`;
const imgMarruecos = `${import.meta.env.BASE_URL}/images/trips/marruecos.jpg`;
const imgTranspirenaica = `${import.meta.env.BASE_URL}/images/trips/transpirenaica.jpg`;
const imgPicosEuropa = `${import.meta.env.BASE_URL}/images/trips/picos-europa.jpg`;
---

<Layout metadata={metadata}>
  <section class="relative min-h-screen overflow-hidden bg-black text-white">
    <img src={heroImage} alt="" class="absolute inset-0 h-full w-full object-cover" />

    <div class="absolute inset-0 z-10 bg-gradient-to-r from-black via-black/75 to-black/20"></div>
    <div class="absolute inset-0 z-10 bg-black/20"></div>

    <div class="relative z-20 mx-auto flex min-h-screen max-w-7xl items-center px-6 py-24">
      <div class="max-w-3xl">
        <p class="mb-6 font-display text-lg uppercase tracking-[0.35em] text-red-600 md:text-xl">
          Experiencias sobre dos ruedas
        </p>

        <h1 class="font-display text-6xl uppercase leading-[1.05] tracking-wide md:text-8xl">
          Viajando en moto<br />
          desde <span class="text-red-600">Madrid</span><br />
          por el mundo
        </h1>

        <p class="mt-6 max-w-xl text-lg text-gray-300">
          Rutas reales, experiencias auténticas y consejos útiles para quienes buscan nuevos paisajes e historias para
          recordar.
        </p>

        <div class="mt-10 flex flex-wrap gap-4">
          <a
            href={`${import.meta.env.BASE_URL}/viajes`}
            class="rounded bg-red-600 px-8 py-4 text-sm font-bold uppercase text-white transition hover:bg-red-700"
          >
            Ver viajes
          </a>

          <a
            href={`${import.meta.env.BASE_URL}/rutas-gpx`}
            class="rounded border border-white/40 px-8 py-4 text-sm font-bold uppercase text-white transition hover:bg-white hover:text-black"
          >
            Rutas GPX
          </a>

          <a
            href={`${import.meta.env.BASE_URL}/sobre-mi`}
            class="rounded border border-white/40 px-8 py-4 text-sm font-bold uppercase text-white transition hover:bg-white hover:text-black"
          >
            Sobre mí
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-black px-6 py-24 text-white">
    <div class="mx-auto max-w-7xl">
      <div class="mb-12 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="font-display text-lg uppercase tracking-[0.35em] text-red-600">Historias sobre dos ruedas</p>
          <h2 class="mt-3 font-display text-5xl uppercase leading-none md:text-6xl">Últimos viajes</h2>
        </div>

        <a
          href={`${import.meta.env.BASE_URL}/es/viajes`}
          class="font-display text-xl uppercase tracking-wide text-white transition hover:text-red-600"
        >
          Ver todos →
        </a>
      </div>

      <div class="grid gap-8 md:grid-cols-3">
        <TripCard
          title="Marruecos"
          description="De Madrid al desierto: pistas sencillas, puertos de montaña, gargantas y noches junto a las dunas."
          image={imgMarruecos}
          category="Marruecos"
          tags="Aventura · Offroad · Desierto"
          href={`${import.meta.env.BASE_URL}/es/viajes/marruecos`}
        />

        <TripCard
          title="Transpirenaica"
          description="Del Cantábrico al Mediterráneo y vuelta, cruzando puertos, valles y algunos de los mejores paisajes del norte."
          image={imgTranspirenaica}
          category="Pirineos"
          tags="Curvas · Montaña · Paisajes"
          href={`${import.meta.env.BASE_URL}/es/viajes/transpirenaica`}
        />

        <TripCard
          title="Picos de Europa"
          description="Carreteras espectaculares, miradores, desfiladeros y pueblos perfectos para una escapada motera."
          image={imgPicosEuropa}
          category="Picos"
          tags="Asfalto · Montaña · Norte"
          href={`${import.meta.env.BASE_URL}/es/viajes/picos-de-europa`}
        />
      </div>
    </div>
  </section>
</Layout>
