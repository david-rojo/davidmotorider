---
import { ANALYTICS } from 'astrowind:config';

const googleAnalyticsId = ANALYTICS?.vendors?.googleAnalytics?.id;
---

<script is:inline define:vars={{ googleAnalyticsId: googleAnalyticsId ? String(googleAnalyticsId) : '' }}>
  window.davidMotoriderLoadAnalytics = function () {
    if (!googleAnalyticsId || window.davidMotoriderAnalyticsLoaded) return;

    window.davidMotoriderAnalyticsLoaded = true;
    window.dataLayer = window.dataLayer || [];
    window.gtag = function (...args) {
      window.dataLayer.push(args);
    };

    const script = document.createElement('script');
    script.async = true;
    script.src = `https://www.googletagmanager.com/gtag/js?id=${googleAnalyticsId}`;
    document.head.appendChild(script);

    window.gtag('js', new Date());
    window.gtag('config', googleAnalyticsId);
  };

  if (localStorage.getItem('davidmotorider_analytics_consent') === 'accepted') {
    window.davidMotoriderLoadAnalytics();
  }
</script>
