---
import { ANALYTICS } from 'astrowind:config';

const googleAnalyticsId = ANALYTICS?.vendors?.googleAnalytics?.id ? String(ANALYTICS.vendors.googleAnalytics.id) : '';
---

{
  googleAnalyticsId ? (
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${googleAnalyticsId}`} />
  ) : null
}

<script is:inline define:vars={{ googleAnalyticsId }}>
  if (googleAnalyticsId) {
    window.dataLayer = window.dataLayer || [];
    window.gtag = function gtag(...args) {
      window.dataLayer.push(args);
    };

    window.gtag('consent', 'default', {
      analytics_storage: 'denied',
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
    });

    window.gtag('js', new Date());

    window.davidMotoriderGrantAnalyticsConsent = function () {
      window.gtag('consent', 'update', {
        analytics_storage: 'granted',
      });
      window.gtag('config', googleAnalyticsId);
    };

    window.davidMotoriderDenyAnalyticsConsent = function () {
      window.gtag('consent', 'update', {
        analytics_storage: 'denied',
      });
    };

    if (localStorage.getItem('davidmotorider_analytics_consent') === 'accepted') {
      window.davidMotoriderGrantAnalyticsConsent();
    }
  }
</script>
