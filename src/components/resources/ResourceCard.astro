---
export interface Props {
  title: string;
  description: string;
  image?: string;
  tags: string;
  href: string;
}

const { title, image, tags, href } = Astro.props;
const tagList = tags.split(' · ');
---

<article
  class="group overflow-hidden rounded-2xl bg-zinc-950 ring-1 ring-white/10 transition duration-300 hover:-translate-y-1 hover:ring-red-600/60"
>
  <a href={href} class="block">
    {
      image && (
        <div class="h-56 overflow-hidden">
          <img
            src={image}
            alt={title}
            loading="lazy"
            decoding="async"
            width="800"
            height="450"
            class="h-full w-full object-cover transition duration-700 group-hover:scale-105"
          />
        </div>
      )
    }

    <div class="p-6">
      <div class="flex flex-wrap gap-2">
        {
          tagList.map((tag) => (
            <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 font-display text-xs uppercase tracking-wide text-zinc-400">
              {tag}
            </span>
          ))
        }
      </div>

      <h3 class="mt-5 font-display text-3xl uppercase leading-none text-white transition group-hover:text-red-500">
        {title}
      </h3>

      <div
        class="mt-6 font-display text-base uppercase tracking-wide text-red-600 transition duration-300 md:opacity-0 md:group-hover:translate-x-1 md:group-hover:opacity-100"
      >
        Ver recurso →
      </div>
    </div>
  </a>
</article>
