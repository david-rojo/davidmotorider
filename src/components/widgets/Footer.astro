---
import Logo from '~/components/Logo.astro';
import { Icon } from 'astro-icon/components';

const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL;
---

<footer class="bg-black text-white">
  <!-- Lema -->
  <div class="border-y border-red-900/40 bg-gradient-to-r from-red-950 via-red-800 to-red-950 px-6 py-5 text-center">
    <p class="font-display text-3xl uppercase tracking-wide md:text-4xl">
      <span class="text-red-500">//</span>
      Arranca la moto. Viaja y descubre
      <span class="text-red-500">//</span>
    </p>
  </div>

  <!-- Contenido -->
  <div class="mx-auto grid max-w-7xl gap-12 px-6 py-14 md:grid-cols-[1.6fr_0.8fr_0.8fr]">
    <!-- Marca -->
    <div>
      <Logo />
      <p class="mt-4 max-w-xs text-sm text-zinc-400">Viajando en moto desde Madrid por el mundo</p>

      <div class="mt-6 flex items-center gap-4">
        <a
          href="https://instagram.com/davidmotorider"
          target="_blank"
          rel="noopener noreferrer"
          class="text-zinc-400 transition hover:text-red-500"
        >
          <Icon name="tabler:brand-instagram" class="h-5 w-5" />
        </a>

        <a
          href="https://es.wikiloc.com/wikiloc/user.do?id=1514299"
          target="_blank"
          rel="noopener noreferrer"
          class="text-zinc-400 transition hover:text-red-500"
        >
          <img
            src={`${base}/images/wikiloc.svg`}
            alt="Wikiloc"
            class="h-4 w-auto brightness-0 invert opacity-60 transition hover:opacity-100 hover:[filter:brightness(0)_saturate(100%)_invert(36%)_sepia(84%)_saturate(2477%)_hue-rotate(343deg)_brightness(92%)_contrast(94%)]"
          />
        </a>
        <a
          href="mailto:davidmotorider@gmail.com"
          aria-label="Email"
          class="text-zinc-400 transition hover:text-red-500"
        >
          <Icon name="tabler:mail" class="h-5 w-5" />
        </a>
      </div>
    </div>

    <!-- Enlaces -->
    <div class="md:justify-self-center">
      <h3 class="font-display text-xl uppercase tracking-wide text-red-600">Enlaces</h3>
      <ul class="mt-4 space-y-2 text-sm text-zinc-400">
        <li><a href={`${base}/`} class="hover:text-white">Inicio</a></li>
        <li><a href={`${base}/viajes`} class="hover:text-white">Viajes</a></li>
        <!--disable escapadas -->
        <!-- <li><a href={`${base}/escapadas`} class="hover:text-white">Escapadas</a></li> -->
        <li><a href={`${base}/recursos`} class="hover:text-white">Recursos</a></li>
        <li><a href={`${base}/donde-dormir`} class="hover:text-white">Dónde dormir</a></li>
        <li><a href={`${base}/sobre-mi`} class="hover:text-white">Sobre mí</a></li>
      </ul>
    </div>

    <!-- Redes -->
    <div class="md:justify-self-center">
      <h3 class="font-display text-xl uppercase tracking-wide text-red-600">Sígueme</h3>
      <ul class="mt-4 space-y-3 text-sm text-zinc-400">
        <li>
          <a
            href="https://instagram.com/davidmotorider"
            target="_blank"
            class="flex items-center gap-2 hover:text-white"
          >
            <Icon name="tabler:brand-instagram" class="h-5 w-5" />
            Instagram
          </a>
        </li>
        <li>
          <a
            href="https://es.wikiloc.com/wikiloc/user.do?id=1514299"
            target="_blank"
            class="group flex items-center gap-2 hover:text-white"
          >
            <img
              src={`${base}/images/wikiloc.svg`}
              alt="Wikiloc"
              class="h-4 w-auto brightness-0 invert opacity-60 transition group-hover:opacity-100"
            />
            Wikiloc
          </a>
        </li>
      </ul>
    </div>
  </div>

  <!-- Bottom -->
  <div class="border-t border-white/10 px-6 py-5">
    <div
      class="mx-auto flex max-w-7xl flex-col items-center gap-4 text-center text-xs text-zinc-500 md:flex-row md:justify-between md:text-left"
    >
      <p>
        © {year} DavidMotoRider. Todos los derechos reservados
      </p>

      <div class="flex flex-wrap items-center justify-center gap-4 md:justify-start">
        <a href={`${base}/aviso-legal`} class="transition hover:text-white"> Aviso legal </a>

        <a href={`${base}/privacidad`} class="transition hover:text-white"> Privacidad </a>

        <a href={`${base}/cookies`} class="transition hover:text-white"> Cookies </a>
      </div>

      <p class="hidden md:block">Viajes reales, experiencias auténticas</p>
    </div>
  </div>
</footer>
