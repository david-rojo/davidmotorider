---
export interface Props {
  title: string;
  description: string;
  image: string;
  category: string;
  tags: string;
  href: string;
}

const { title, description, image, category, tags, href } = Astro.props;
---

<article class="group overflow-hidden rounded-2xl bg-zinc-900">
  <a href={href}>
    <div class="relative h-80 overflow-hidden">
      <img src={image} alt={title} class="h-full w-full object-cover transition duration-500 group-hover:scale-110" />

      <div class="absolute inset-0 bg-gradient-to-t from-black via-black/20 to-transparent"></div>

      <span
        class="absolute left-5 top-5 rounded-full bg-red-600 px-4 py-1 font-display text-sm uppercase tracking-wide"
      >
        {category}
      </span>
    </div>

    <div class="p-6">
      <p class="font-display text-sm uppercase tracking-[0.25em] text-zinc-400">
        {tags}
      </p>

      <h3 class="mt-3 font-display text-3xl uppercase leading-none text-white">
        {title}
      </h3>

      <p class="mt-4 text-sm leading-6 text-zinc-400">
        {description}
      </p>
    </div>
  </a>
</article>
